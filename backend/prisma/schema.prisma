generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model theme_sounds {
  theme_id String @db.VarChar(50)
  slot     Int
  filename String @db.VarChar(255)
  themes   themes @relation(fields: [theme_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "theme_sounds_ibfk_1")

  @@id([theme_id, slot])
}

model themes {
  id           String         @id @db.VarChar(50)
  name         String         @db.VarChar(100)
  bg_image     String?        @db.VarChar(255)
  body_class   String?        @db.VarChar(100)
  theme_sounds theme_sounds[]
}

model users {
  id            String   @id @default(uuid()) @db.VarChar(50)
  username      String   @unique @db.VarChar(100)
  email         String?  @unique @db.VarChar(255)
  password_hash String?  @db.VarChar(255) // null for OAuth-only users
  github_id     String?  @unique @db.VarChar(50)
  avatar        String?  @db.VarChar(255)
  created_at    DateTime @default(now())
  sent_friendships     friendships[] @relation("sent_friendships")
  received_friendships friendships[] @relation("received_friendships")
  sent_messages        messages[]    @relation("sent_messages")
  received_messages    messages[]    @relation("received_messages")
}

enum friendship_status {
  pending
  accepted
}

// One row per pair of users. While pending, requester -> addressee is the request direction.
model friendships {
  requester_id String            @db.VarChar(50)
  addressee_id String            @db.VarChar(50)
  status       friendship_status @default(pending)
  created_at   DateTime          @default(now())
  requester    users             @relation("sent_friendships", fields: [requester_id], references: [id], onDelete: Cascade)
  addressee    users             @relation("received_friendships", fields: [addressee_id], references: [id], onDelete: Cascade)

  @@id([requester_id, addressee_id])
}

// One row per message. sender -> receiver
model messages {
  id            String    @id @default(uuid()) @db.VarChar(50)
  sender_id     String    @db.VarChar(50)
  receiver_id   String    @db.VarChar(50)
  content       String    @db.Text
  created_at    DateTime  @default(now())
  sender        users     @relation("sent_messages", fields: [sender_id], references: [id], onDelete: Cascade)
  receiver      users     @relation("received_messages", fields: [receiver_id], references: [id], onDelete: Cascade)

  @@index([sender_id, receiver_id, created_at])
  @@index([receiver_id, sender_id, created_at])
}
